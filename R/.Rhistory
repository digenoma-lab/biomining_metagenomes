names=read.table("prev_adm/HAP_AMR_CHI_EFP_prune.fam",header=F)
pop2id=data.frame(pop=c(rep("AMR",43),rep("DCHI",166),rep("BCEU",56),rep("DCHI",176),rep("CYRI",55)),id=names$V2)
tbl=read.table("prev_adm/HAP_AMR_CHI_EFP_prune.3.Q")
adm=cbind(pop2id,tbl)
adm=adm %>% arrange(pop,-V2,-V1)
colnames(adm)=c("pop","id","EUR","AMR","AFR")
barplot(t(as.matrix(adm[3:5])), col=rainbow(3), xlab="Individual #", ylab="Ancestry",space =0.05, border=NA, main="K=3")
chi_adm=adm %>% filter(pop=="DCHI")
write.table(chi_adm,"prev_adm/ADMIXTURE_CHI.K3.txt",quote=F,row.names=F,sep="\t")
summary(chi_adm[3:5])
names=read.table("prev_adm/HAP_AMR_CHI_EFP_prune.fam",header=F)
pop2id=data.frame(pop=c(rep("AMR",43),rep("DCHI",166),rep("BCEU",56),rep("DCHI",176),rep("CYRI",55)),id=names$V2)
tbl=read.table("prev_adm/HAP_AMR_CHI_EFP_prune.4.Q")
adm=cbind(pop2id,tbl)
adm=adm %>% arrange(pop,desc(V4),desc(V1),desc(V3))
colnames(adm)=c("pop","id","EUR","AMR","AFR","MAP")
