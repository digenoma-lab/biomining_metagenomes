install.packages(c("ggplot2", "gridExtra", "label.switching", "tidyr", "remotes"), repos = "https://cloud.r-project.org")
remotes::install_github('royfrancis/pophelper')
library("pophelper")
library('gridExtra')
#setwd("/mnt/beegfs/labs/Eli/analysis/adm/")
#path<-"/mnt/beegfs/labs/Eli/analysis/adm/"
files <- c('prev_adm/HAP_AMR_CHI_EFP_prune.2.Q',
'prev_adm/HAP_AMR_CHI_EFP_prune.3.Q',
'prev_adm/HAP_AMR_CHI_EFP_prune.4.Q',
'prev_adm/HAP_AMR_CHI_EFP_prune.5.Q',
'prev_adm/HAP_AMR_CHI_EFP_prune.6.Q')
alist <- readQ(files, filetype="basic")
#groups=c(rep("AMR",43),rep("CHI",166),rep("AEUR",56),rep("CHI",176),rep("AFR",55))
groups=c(rep("AMR",43),rep("CHI",166),rep("AEUR",56),rep("CHI",176),rep("AFR",55))
#attempt to replicate fixcolours from AdmixturePlotter script
slistk<-tabulateQ(alist)$k
for (i in 2: length(slistk)){
k<-slistk[i]
prevk<-slistk[i-1]
slistattributes<-attributes(alist[[i]]) # copy attributes
cor_mat<-cor(alist[[i-1]],alist[[i]])
component_order<-apply(cor_mat, 1,which.max)
while (any(duplicated(component_order)) ) {
duplicates <- as.numeric(component_order[which(duplicated(component_order))])
for (duplicate in duplicates){
condition = T
while (condition == T) {
cor_mat[cor_mat==min(cor_mat[component_order==duplicate,duplicate])] = -100 # remove lowest-scoring duplicate by setting correlation to -100
component_order<-apply(cor_mat, 1,which.max)
if (duplicate %in% as.numeric(component_order[which(duplicated(component_order))]) == F) {condition = F} # keep going as long as duplicates remain
}
}
}
if (k != prevk ) {component_order<-c(component_order, setdiff(1:k, component_order)) } # add additional component when k is increased
alist[[i]]<-alist[[i]][,component_order]
attributes(alist[[i]])<-slistattributes #restore attributes
}
p2 <- plotQ(alignK(sortQ(alist)[2]), exportpath=getwd(),
exportplot=T, imgtype="pdf",
height=6, width=16,
outputfilename="admixture-eli-K3",
sortind="Cluster3",
#useindlab=T,
#showindlab=T,
sharedindlab=F,
ordergrp=TRUE,
grplab=as.data.frame(groups),
#subsetgrp=c("AMR","EUR","AFR","CHI"),
indlabsize = 10,
panelspacer=0.5,
grplabsize = 4,
splab=c("K=3"),
returnplot=T,
basesize=11,
pointsize = 5,
#barbordercolour="white",barbordersize=0,
clustercol=c("#BE0032","#008856","#F38400","#0067A5"),
showlegend = TRUE,
#legendkeysize = 10,
legendtextsize = 12,
showtitle=T,
showsubtitle=T,
showyaxis=T,
ticksize=1,
#grpmean=T,
titlelab="Population structure of Chilean individuals",
subtitlelab="Admixture analysis")
