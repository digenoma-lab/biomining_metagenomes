# Load necessary libraries
library(ggplot2)
library(dplyr)
# Read PCA results (PLINK eigenvec file)
pca_data <- read.table("PCA_results.eigenvec", header = FALSE)
# Rename columns for clarity
colnames(pca_data) <- c("FID", "IID", paste0("PC", 1:(ncol(pca_data) - 2)))
# Print the first few rows to check data
head(pca_data)
ggplot(pca_data, aes(x = PC1, y = PC2)) +
geom_point(alpha = 0.7, color = "blue") +
labs(title = "PCA of Genomic Data",
x = "Principal Component 1 (PC1)",
y = "Principal Component 2 (PC2)") +
theme_minimal()
# Load population metadata
pop_data <- read.table("20130606_g1k_3202_samples_ped_population.txt", header = TRUE)
head(pop_data)
head(pca_data)
# Merge PCA and population info
pca_data <- inner_join(pca_data, pop_data, by = c("IID", "SampleID"))
# Merge PCA and population info
pca_data <- inner_join(pca_data, pop_data, by = c("IID"="SampleID"))
head(pca_data)
tail(pca_data)
dim(pca_data)
